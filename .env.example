# taleclaw 环境变量示例
#
# 使用时复制为 .env，然后只填写你需要启用的部分。
# 不要提交真实 .env。


# ---------------------------------------------------------------------------
# 1. 模型 Provider
# ---------------------------------------------------------------------------
# 推荐使用 OpenAI 兼容的自建 API 中转站。
# Base URL 通常写到 /v1，不要写到 /v1/chat/completions。

LLM_PROVIDER=openai_relay
OPENAI_RELAY_API_KEY=replace-me
OPENAI_RELAY_BASE_URL=https://your-relay.example.com/v1
OPENAI_RELAY_MODEL=gpt-4o-mini
OPENAI_RELAY_MAX_TOKENS_PARAM=max_tokens
# 中转站如果要求 wire_api = "responses"，这里设为 responses。
# 普通 /v1/chat/completions 兼容服务保持 chat_completions。
OPENAI_RELAY_WIRE_API=responses

# 通用单 Provider 覆盖配置。除非你想临时覆盖当前 LLM_PROVIDER，
# 否则保持为空即可。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MAX_TOKENS_PARAM=

# 可选内置 Provider 配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_MAX_TOKENS_PARAM=max_completion_tokens
MIMO_WIRE_API=chat_completions


# ---------------------------------------------------------------------------
# 2. 模型路由
# ---------------------------------------------------------------------------
# 把不同类型的模型任务路由到不同 Provider。
# 如果只用一个中转站，可以全部指向 openai_relay。

LLM_ROUTE_DEFAULT=openai_relay,deepseek,mimo
LLM_ROUTE_CHAT=openai_relay,deepseek,mimo
LLM_ROUTE_CODING=openai_relay,deepseek,mimo
LLM_ROUTE_SUMMARY=openai_relay,deepseek,mimo
LLM_ROUTE_HYBRID=openai_relay,deepseek,mimo
LLM_ROUTE_TEAMMATE=openai_relay,deepseek,mimo
LLM_ROUTE_REFLECTION=openai_relay,deepseek,mimo
LLM_ROUTE_COMPACT=openai_relay,deepseek,mimo
LLM_ROUTE_TASK_CONCLUSION=openai_relay
LLM_ROUTE_FALLBACK=

# Provider 健康检查与自动切换。
# 默认关闭，避免本地 import / 测试时自动请求外部模型服务。
# 开启后，启动时会检测指定 purpose 的 primary provider；
# 如果 primary 不通，会在 cooldown 窗口内优先切到 route 里的后备 provider。
LLM_HEALTHCHECK_ON_STARTUP=0
LLM_HEALTHCHECK_PURPOSES=chat,coding,summary,hybrid

# 运行中某个 provider 连续失败达到阈值后，会临时跳过它。
# 启动健康检查失败会立即进入 cooldown；普通运行失败按阈值累计。
LLM_PROVIDER_FAILURE_THRESHOLD=3
LLM_PROVIDER_FAILURE_COOLDOWN_SECONDS=300

# 可选：用 JSON 配置多个 Provider profile。
# LLM_PROVIDERS_JSON={"openai_relay":{"api_key_env":"OPENAI_RELAY_API_KEY","base_url":"https://your-relay.example.com","model":"gpt-4o-mini","wire_api":"responses"},"deepseek":{"api_key_env":"DEEPSEEK_API_KEY","base_url":"https://api.deepseek.com","model":"deepseek-v4-flash"},"mimo":{"api_key_env":"MIMO_API_KEY","base_url":"https://api.xiaomimimo.com/v1","model":"mimo-v2.5-pro","max_tokens_param":"max_completion_tokens"}}
# LLM_ROUTES_JSON={"chat":"openai_relay,deepseek","coding":"openai_relay,deepseek","summary":"mimo,openai_relay","hybrid":"openai_relay"}


# ---------------------------------------------------------------------------
# 3. 运行时行为
# ---------------------------------------------------------------------------

USE_LOCAL_PROXY=0
# LOCAL_PROXY_URL=http://127.0.0.1:7897

REFLECTION_ENABLED=0
REFLECTION_MAX_TOKENS=500
REFLECTION_MIN_REASONING_STEPS=6

HYBRID_ROUTE_MODEL=
HYBRID_ROUTE_MAX_TOKENS=160

TASK_SANDBOX_TTL_HOURS=168
MARKDOWN_PDF_MAX_BYTES=2097152

# Context section budget 默认关闭。开启后只裁可再生/低风险 section：
# mode_instructions、project_instructions、memory、task_runtime_events。
# session messages 和最新用户请求不会在这一层被裁。
CONTEXT_ENABLE_SECTION_BUDGET=0
CONTEXT_BUDGET_CHARS=24000
CONTEXT_MODE_INSTRUCTIONS_BUDGET=3000
CONTEXT_PROJECT_INSTRUCTIONS_BUDGET=3000
CONTEXT_MEMORY_BUDGET=2500
CONTEXT_TASK_RUNTIME_EVENTS_BUDGET=2000
CONTEXT_MODE_INSTRUCTIONS_FLOOR=1000
CONTEXT_PROJECT_INSTRUCTIONS_FLOOR=1000
CONTEXT_MEMORY_FLOOR=500
CONTEXT_TASK_RUNTIME_EVENTS_FLOOR=300


# ---------------------------------------------------------------------------
# 4. Web 控制台
# ---------------------------------------------------------------------------

WEB_USERNAME=agent
WEB_PASSWORD=replace-with-a-strong-password

# 多用户部署时建议使用 WEB_USERS_JSON，并删除 WEB_USERNAME /
# WEB_PASSWORD，避免配置含义混乱。
# WEB_USERS_JSON={"admin":{"password":"change-admin","role":"admin"},"guest":{"password":"change-guest","role":"user"}}

WEB_ALLOW_REGISTRATION=1
WEB_ALLOW_ANONYMOUS=0
WEB_SESSION_TTL_HOURS=168
WEB_COOKIE_SECURE=0
WEB_MAX_BODY_BYTES=52428800


# ---------------------------------------------------------------------------
# 5. Scheduler 与插件
# ---------------------------------------------------------------------------

TAVILY_API_KEY=replace-me

SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_RECONCILE_SECONDS=30
SCHEDULER_ANALYSIS_MODEL=
SCHEDULER_ANALYSIS_MAX_TOKENS=1800
SCHEDULER_PLANNER_MODEL=
SCHEDULER_PLANNER_MAX_TOKENS=1000


# ---------------------------------------------------------------------------
# 6. Python 与 Docker 构建
# ---------------------------------------------------------------------------

PYTHON_IMAGE=python:3.12-slim
PIP_INDEX_URL=https://pypi.org/simple
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=
PIP_DEFAULT_TIMEOUT=180
PIP_RETRIES=10


# ---------------------------------------------------------------------------
# 7. Telegram 网关
# ---------------------------------------------------------------------------
# 默认不启用。只有启动 telegram_worker 且配置 TELEGRAM_BOT_TOKEN 后才会工作。
# 详见 docs/gateways/TELEGRAM_GATEWAY.md。

TELEGRAM_BOT_TOKEN=

# 逗号分隔的 Telegram user ID。使用 * 表示允许任意 Telegram 用户
# 作为普通隔离账号接入。
TELEGRAM_ALLOWED_USER_IDS=

# 显式映射可以把 Telegram 用户绑定到已有 user_id，或授予 admin 角色。
# TELEGRAM_USER_MAP={"123456789":{"user_id":"admin","role":"admin"}}
TELEGRAM_USER_MAP=

TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_RETRY_DELAY=3
TELEGRAM_PROXY_URL=

TELEGRAM_NOTIFY_CHAT_IDS=
TELEGRAM_NOTIFY_MAX_CHARS=3500
TELEGRAM_NOTIFY_SEND_REPORT_FILE=1
TELEGRAM_NOTIFY_DOCUMENT_MAX_BYTES=10485760

TELEGRAM_OUTBOX_BATCH_SIZE=10
TELEGRAM_OUTBOX_MAX_ATTEMPTS=3
TELEGRAM_STORAGE_PREVIEW_BYTES=8000
TELEGRAM_STORAGE_DOWNLOAD_MAX_BYTES=10485760


# ---------------------------------------------------------------------------
# 8. 飞书网关
# ---------------------------------------------------------------------------
# 默认不启用。只有启动 feishu_worker 且配置飞书应用凭据后才会工作。
# 详见 docs/gateways/FEISHU_GATEWAY.md。

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_BASE_URL=https://open.feishu.cn

FEISHU_CALLBACK_HOST=0.0.0.0
FEISHU_CALLBACK_PORT=8010
FEISHU_CALLBACK_PATH=/feishu/events
FEISHU_CALLBACK_MAX_BYTES=1048576
FEISHU_CALLBACK_ACK_TIMEOUT=5

# 逗号分隔的飞书 open_id。使用 * 表示允许任意飞书用户
# 作为普通隔离账号接入。
FEISHU_ALLOWED_OPEN_IDS=

# 显式映射可以把飞书用户绑定到已有 user_id，或授予 admin 角色。
# FEISHU_USER_MAP={"ou_xxx":{"user_id":"admin","role":"admin"}}
FEISHU_USER_MAP=

# 群聊默认只有 @ 机器人时才响应。设为 1 后，群里所有文本都会触发响应。
FEISHU_RESPOND_IN_GROUPS=0
FEISHU_BOT_OPEN_ID=
FEISHU_PROXY_URL=

FEISHU_NOTIFY_CHAT_IDS=
FEISHU_NOTIFY_MAX_CHARS=3500
FEISHU_NOTIFY_SEND_REPORT_FILE=1
FEISHU_NOTIFY_DOCUMENT_MAX_BYTES=10485760

FEISHU_OUTBOX_BATCH_SIZE=10
FEISHU_OUTBOX_MAX_ATTEMPTS=3
FEISHU_OUTBOX_POLL_SECONDS=2
FEISHU_STORAGE_PREVIEW_BYTES=8000
FEISHU_STORAGE_DOWNLOAD_MAX_BYTES=10485760
