    {
      "id": "coding-add-feature-003",
      "category": "feature",
      "fixture_repo": "benchmarks/fixtures/coding_add_feature",
      "prompt": "新增 normalize_whitespace(text) 函数，并为它增加测试。",
      "step_budget": 9,
      "allowed_tools": ["read_file", "edit_file", "write_file", "bash", "git_diff"],
      "expected": {
        "must_pass_command": "python -m pytest -q",
        "modified": ["src/string_tools.py"],
        "created": ["tests/test_normalize_whitespace.py"],
        "trace_events": ["workspace.resolved", "workspace.diff.written"],
        "tool_called": ["write_file", "edit_file", "bash"]
      },
      "verifier": "coding_feature_pytest",
      "script": [
        {"tool": "read_file", "args": {"path": "src/string_tools.py"}},
        {"tool": "tool_search", "args": {"query": "select:edit_file"}},
        {"tool": "edit_file", "args": {"path": "src/string_tools.py", "old_text": "def slugify(text):\n    return text.lower().replace(\" \", \"-\")\n", "new_text": "def slugify(text):\n    return text.lower().replace(\" \", \"-\")\n\n\ndef normalize_whitespace(text):\n    return \" \".join(text.split())\n"}},
        {"tool": "tool_search", "args": {"query": "select:write_file"}},
        {"tool": "write_file", "args": {"path": "tests/test_normalize_whitespace.py", "content": "from src.string_tools import normalize_whitespace\n\n\ndef test_normalize_whitespace():\n    assert normalize_whitespace('  hello\\n  world\\t ') == 'hello world'\n"}},
        {"tool": "tool_search", "args": {"query": "select:bash"}},
        {"tool": "bash", "args": {"command": "python -m pytest -q"}},
        {"final": "Added normalize_whitespace with tests and verified the suite."}
      ]
    },
    {
