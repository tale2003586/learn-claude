{
  "schema_version": 1,
  "description": "Coding Agent Harness Regression v1. Each task runs in a fresh real workspace copy with deterministic scripted model outputs.",
  "tasks": [
    {
      "id": "coding-fix-math-001",
      "category": "bugfix",
      "fixture_repo": "benchmarks/fixtures/coding_fix_math",
      "prompt": "修复单元测试失败，不要修改测试。修复后运行测试确认通过。",
      "step_budget": 8,
      "allowed_tools": ["read_file", "edit_file", "bash", "git_status", "git_diff"],
      "expected": {
        "must_pass_command": "python -m pytest -q",
        "modified": ["src/math_tools.py"],
        "not_modified": ["tests/test_math_tools.py"],
        "trace_events": ["workspace.resolved", "workspace.diff.written"],
        "tool_called": ["git_status", "read_file", "edit_file", "bash"]
      },
      "verifier": "coding_bugfix_pytest",
      "script": [
        {"tool": "git_status", "args": {}},
        {"tool": "read_file", "args": {"path": "src/math_tools.py"}},
        {"tool": "tool_search", "args": {"query": "select:edit_file"}},
        {"tool": "edit_file", "args": {"path": "src/math_tools.py", "old_text": "return high\n    if value > high:\n        return low", "new_text": "return low\n    if value > high:\n        return high"}},
        {"tool": "tool_search", "args": {"query": "select:bash"}},
        {"tool": "bash", "args": {"command": "python -m pytest -q"}},
        {"final": "Fixed clamp boundary handling and verified tests pass."}
      ]
    },
    {
