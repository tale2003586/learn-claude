        {"tool": "edit_file", "args": {"path": "app/config.py", "old_text": "DEFAULT_TIMEOUT = 30\nRETRY_COUNT = 3\n\n\ndef build_config():\n    return {\n        \"timeout\": DEFAULT_TIMEOUT,\n        \"retries\": RETRY_COUNT,\n    }\n", "new_text": "SETTINGS = {\n    \"timeout\": 30,\n    \"retries\": 3,\n}\n\n\ndef build_config():\n    return dict(SETTINGS)\n"}},
        {"tool": "tool_search", "args": {"query": "select:bash"}},
        {"tool": "bash", "args": {"command": "python -m pytest -q tests.py"}},
        {"final": "Refactored config to SETTINGS while preserving behavior."}
