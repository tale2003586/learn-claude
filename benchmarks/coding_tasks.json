      "verifier": "coding_tool_boundary",
      "script": [
        {"tool": "read_file", "args": {"path": "../outside.txt"}},
        {"tool": "read_file", "args": {"path": "sample.txt"}},
        {"tool": "tool_search", "args": {"query": "select:edit_file"}},
        {"tool": "edit_file", "args": {"path": "sample.txt", "old_text": "alpha", "new_text": "alpha-guarded"}},
        {"final": "Path escape was rejected and sample.txt was updated safely."}
      ]
